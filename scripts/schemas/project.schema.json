{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MICU AI Lib project.yaml",
  "type": "object",
  "required": ["name", "authors", "category", "summary"],
  "properties": {
    "name":     { "type": "string", "minLength": 1 },
    "authors":  { "type": "array",  "items": { "type": "string" }, "minItems": 1 },
    "category": { "type": "string", "minLength": 1 },
    "summary":  { "type": "string", "minLength": 1 },
    "tags":     { "type": "array",  "items": { "type": "string" } },
    "status":   { "type": "string", "enum": ["in-progress", "done", "archived"] },
    "updated":  { "type": "string" },
    "cover":    { "type": "string" },
    "logo":     { "type": "string", "minLength": 1 },
    "demo":     { "type": "string" },
    "readme":   { "type": "string" },
    "collection": { "type": "string", "minLength": 1 },
    "links":    {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "subskills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name":    { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "path":    { "type": "string" },
          "status":  { "type": "string", "enum": ["experimental", "stable", "deprecated"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
